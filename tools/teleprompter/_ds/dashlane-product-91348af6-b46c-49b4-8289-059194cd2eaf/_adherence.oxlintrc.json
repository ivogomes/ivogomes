{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/_lib/**",
              "components/actions/**",
              "components/brand/**",
              "components/data/**",
              "components/expressive/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icon/**",
              "components/layout/**",
              "components/loaders/**",
              "components/navigation/**",
              "components/typography/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Public Sans|GT Walsheim Pro|Apercu Mono Pro))/i]",
        "message": "Font not provided by the design system. Available: Public Sans, GT Walsheim Pro, Apercu Mono Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|mood|intensity|layout|iconName|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, mood, intensity, layout, iconName, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:catchy|quiet|supershy)$/]",
        "message": "<Badge> intensity must be one of 'catchy' | 'quiet' | 'supershy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:labelOnly|iconLeading|iconTrailing)$/]",
        "message": "<Badge> layout must be one of 'labelOnly' | 'iconLeading' | 'iconTrailing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BannerLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|isExternal|key|ref|className|style|children)$/]",
        "message": "<BannerLink> doesn't accept that prop. Declared props: label, href, onClick, isExternal."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|mood|intensity|size|layout|icon|fullsize|isLoading|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: as, children, mood, intensity, size, layout, icon, fullsize, isLoading, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
